# ─────────────────────────────────────────────────────────────────────────────
# Conduit Sentinel — environment variable reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Conduit data source ───────────────────────────────────────────────────────
# Sign up at https://conduit.jhubafrica.com to obtain these credentials.
CONDUIT_EMAIL=
CONDUIT_PASSWORD=
# Optional labelled surrogate when the portal is unreachable. Set to 1 for local demo ingest.
CONDUIT_DEMO=
# Optional: REST_API | CSV_EXPORT | PAGE_SCRAPE
CONDUIT_ACCESS_MODE=

# ── LLM providers ────────────────────────────────────────────────────────────
# Google AI Studio — https://aistudio.google.com → Get API key
GEMINI_API_KEY=

# Groq console — https://console.groq.com → API Keys
GROQ_API_KEY=

# ── Telegram bot ─────────────────────────────────────────────────────────────
# Create a bot with @BotFather on Telegram to receive a token.
TELEGRAM_BOT_TOKEN=

# Comma-separated list of chat IDs that should receive advisory alerts.
# Send a message to your bot, then call the Telegram getUpdates API to find chat IDs.
TELEGRAM_CHAT_ID=

# ── Supabase (database & storage) ────────────────────────────────────────────
# Find both values in your Supabase project: Settings → API
SUPABASE_URL=
SUPABASE_KEY=

# ── Hugging Face Hub ──────────────────────────────────────────────────────────
# https://huggingface.co → Settings → Access Tokens → New token
HF_TOKEN=

# ── API server ────────────────────────────────────────────────────────────────
# Deployed frontend URL used for CORS allowlist (e.g. https://your-app.vercel.app)
FRONTEND_ORIGIN=

# ── Anomaly detection ────────────────────────────────────────────────────────
# Rolling window size for M2 anomaly detection, in hours.
# Optional — defaults to 24. Valid range: 1–168.
M2_WINDOW_HOURS=

# ── Frontend (React / Vite) ───────────────────────────────────────────────────
# Base URL of the backend API, consumed by the Vite build.
# Example: https://your-api.railway.app
VITE_API_URL=
